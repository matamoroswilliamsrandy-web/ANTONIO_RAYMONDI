<%- include('../partials/admin-header', { path: '/panel-director/usuarios' }) %>

<div class="adm-page-header">
    <div class="adm-page-header-left">
        <div class="adm-page-icon adm-page-icon--red"><i class="fas fa-user-cog"></i></div>
        <div>
            <h1 class="adm-page-title">Usuarios Admin</h1>
            <p class="adm-page-sub"><%= usuarios.length %> usuario<%= usuarios.length !== 1 ? 's' : '' %> registrado<%= usuarios.length !== 1 ? 's' : '' %></p>
        </div>
    </div>
    <div class="adm-page-header-actions">
        <a href="/" target="_blank" class="adm-header-link"><i class="fas fa-globe"></i> <span>Ver Sitio</span></a>
        <button id="btn-toggle-user-form" class="adm-btn-new" onclick="toggleUserForm()">
            <i class="fas fa-plus" id="user-btn-icon"></i>
            <span id="user-btn-label">Nuevo Usuario</span>
        </button>
    </div>
</div>

<% if (error) { %>
    <div class="adm-alert adm-alert--error"><i class="fas fa-exclamation-circle"></i> <%= error %></div>
<% } %>
<% if (success) { %>
    <div class="adm-alert adm-alert--success"><i class="fas fa-check-circle"></i> <%= success %></div>
<% } %>

<div class="adm-noticias-layout" id="users-layout">
    <aside class="adm-side-panel" id="user-side-panel" aria-hidden="true">
        <div class="adm-side-panel-inner">
            <div class="adm-drawer-header">
                <div class="adm-drawer-title-group">
                    <div class="adm-form-panel-icon"><i class="fas fa-user-plus"></i></div>
                    <div><h3>Nuevo Usuario</h3><p>Completa los campos y guarda</p></div>
                </div>
                <button class="adm-drawer-close" onclick="toggleUserForm()" title="Cerrar"><i class="fas fa-times"></i></button>
            </div>

            <form action="/panel-director/usuarios/crear" method="POST" class="adm-drawer-form">
                <div class="adm-field">
                    <label class="adm-label" for="user-username"><i class="fas fa-user"></i> Nombre de usuario</label>
                    <input id="user-username" name="username" type="text" class="adm-input" minlength="3" maxlength="80" autocomplete="username" required placeholder="Ej. secretaria">
                </div>
                <div class="adm-field">
                    <label class="adm-label" for="user-password"><i class="fas fa-lock"></i> Contraseña segura</label>
                    <div class="adm-password-wrap">
                        <input id="user-password" name="password" type="password" class="adm-input" minlength="8" autocomplete="new-password" required placeholder="Escribe una contraseña segura">
                        <button type="button" class="adm-password-toggle" id="password-toggle" aria-label="Mostrar contraseña" title="Mostrar contraseña">
                            <i class="fas fa-eye"></i>
                        </button>
                    </div>
                    <ul class="adm-password-rules" aria-live="polite">
                        <li id="rule-length"><i class="fas fa-circle"></i><span>Mínimo 8 caracteres</span></li>
                        <li id="rule-uppercase"><i class="fas fa-circle"></i><span>Al menos una mayúscula</span></li>
                        <li id="rule-special"><i class="fas fa-circle"></i><span>Al menos un signo</span></li>
                    </ul>
                </div>
                <div class="adm-side-form-actions">
                    <button type="submit" class="adm-btn-submit" id="save-user-btn" disabled><i class="fas fa-save"></i> Guardar Usuario</button>
                    <button type="button" class="adm-btn-cancel" onclick="toggleUserForm()">Cancelar</button>
                </div>
            </form>
        </div>
    </aside>

    <section class="adm-table-panel">
        <div class="adm-table-panel-header">
            <h3><i class="fas fa-users"></i> Usuarios registrados</h3>
            <span class="adm-count-badge"><%= usuarios.length %></span>
        </div>
        <% if (usuarios.length === 0) { %>
            <div class="adm-empty-state"><div class="adm-empty-icon"><i class="fas fa-users"></i></div><p>No hay usuarios registrados.</p><span>Haz clic en <strong>Nuevo Usuario</strong> para agregar el primero.</span></div>
        <% } else { %>
            <div class="adm-tbl-wrap">
                <table class="adm-tbl">
                    <thead><tr><th>Usuario</th><th style="width:130px; text-align:center">Acción</th></tr></thead>
                    <tbody>
                        <% usuarios.forEach(usuario => { %>
                            <tr class="adm-tbl-row">
                                <td><span class="adm-tbl-title"><i class="fas fa-user-shield"></i> <%= usuario.username %></span></td>
                                <td style="text-align:center">
                                    <% if (String(usuario.id) !== String(usuarioActual.id)) { %>
                                        <form action="/panel-director/usuarios/eliminar/<%= usuario.id %>" method="POST" onsubmit="return confirm('¿Eliminar este usuario?');">
                                            <button type="submit" class="adm-action-btn adm-action-btn--delete" title="Eliminar"><i class="fas fa-trash"></i></button>
                                        </form>
                                    <% } else { %><span class="adm-meta-item">Sesión actual</span><% } %>
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        <% } %>
    </section>
</div>

<script>
    function toggleUserForm() {
        const layout = document.getElementById('users-layout');
        const panel = document.getElementById('user-side-panel');
        const icon = document.getElementById('user-btn-icon');
        const label = document.getElementById('user-btn-label');
        const isOpen = layout.classList.toggle('panel-open');
        panel.setAttribute('aria-hidden', String(!isOpen));
        icon.className = isOpen ? 'fas fa-times' : 'fas fa-plus';
        label.textContent = isOpen ? 'Cerrar' : 'Nuevo Usuario';
    }

    const passwordInput = document.getElementById('user-password');
    const passwordToggle = document.getElementById('password-toggle');
    const saveUserButton = document.getElementById('save-user-btn');
    const rules = {
        length: document.getElementById('rule-length'),
        uppercase: document.getElementById('rule-uppercase'),
        special: document.getElementById('rule-special')
    };

    function validatePassword() {
        const value = passwordInput.value;
        const valid = {
            length: value.length >= 8,
            uppercase: /[A-Z]/.test(value),
            special: /[^A-Za-z0-9]/.test(value)
        };

        Object.entries(valid).forEach(([name, isValid]) => {
            rules[name].classList.toggle('is-valid', isValid);
            rules[name].querySelector('i').className = isValid ? 'fas fa-check-circle' : 'fas fa-circle';
        });
        saveUserButton.disabled = !Object.values(valid).every(Boolean);
    }

    passwordInput.addEventListener('input', validatePassword);
    passwordToggle.addEventListener('click', () => {
        const showing = passwordInput.type === 'text';
        passwordInput.type = showing ? 'password' : 'text';
        passwordToggle.querySelector('i').className = showing ? 'fas fa-eye' : 'fas fa-eye-slash';
        passwordToggle.setAttribute('aria-label', showing ? 'Mostrar contraseña' : 'Ocultar contraseña');
        passwordToggle.title = showing ? 'Mostrar contraseña' : 'Ocultar contraseña';
    });
</script>

<%- include('../partials/admin-footer') %>
